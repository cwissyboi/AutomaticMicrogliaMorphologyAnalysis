import qupath.lib.regions.RegionRequest
import javax.imageio.ImageIO

def server = getCurrentImageData().getServer()

def tileSize = 512
def downsample = 1.0
def maxTiles = 1000

def outDir = "C:/Users/chris/Desktop/tiles_test"
mkdirs(outDir)

int width = server.getWidth()
int height = server.getHeight()

int tileID = 0

outer:
for (int y = height / 2; y < height; y += tileSize) {
    for (int x = width / 2 ; x < width; x += tileSize) {

        if (tileID >= maxTiles)
            break outer

        def region = RegionRequest.createInstance(
            server.getPath(),
            downsample,
            x, y,
            tileSize, tileSize
        )

        def img = server.readBufferedImage(region)
        if (img == null)
            continue

        def outPath = outDir + File.separator +
            String.format("tile_%03d_x%d_y%d.jpg", tileID, x, y)

        ImageIO.write(img, "JPEG", new File(outPath))
        tileID++
    }
}

print "Exported ${tileID} tiles"