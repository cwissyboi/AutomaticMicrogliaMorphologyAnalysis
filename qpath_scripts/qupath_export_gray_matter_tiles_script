import qupath.lib.regions.RegionRequest
import javax.imageio.ImageIO
import java.util.concurrent.Executors
import java.util.concurrent.atomic.AtomicInteger
import java.util.concurrent.CopyOnWriteArrayList

def imageData = getCurrentImageData()
def server = imageData.getServer()
def hierarchy = imageData.getHierarchy()

def tileSize = 512
def downsample = 1.0

// Number of parallel threads — tune to your machine (4-8 is a good range)
def numThreads = 4

// --------------------------------------------------
// Base output directory
// --------------------------------------------------
def baseOutDir = "C:\\Users\\chris\\Desktop\\University\\Thesis\\All_scans_tiled_whole_box_in_GM_parallel"
mkdirs(baseOutDir)

// --------------------------------------------------
// Get current image name (cleaned safely)
// --------------------------------------------------
def imageName = imageData.getServer().getMetadata().getName()

int dotIndex = imageName.lastIndexOf(".")
if (dotIndex > 0) {
    imageName = imageName.substring(0, dotIndex)
}

imageName = imageName.replace(" ", "_")

// Create scan-specific subfolder
def outDir = baseOutDir + File.separator + imageName
mkdirs(outDir)

print "Exporting GRAY MATTER tiles for scan: ${imageName}"
print "Output folder: ${outDir}"

int width = server.getWidth()
int height = server.getHeight()

// --------------------------------------------------
// All annotations = gray matter
// --------------------------------------------------
def grayAnnotations = hierarchy.getAnnotationObjects()

if (grayAnnotations.isEmpty()) {
    print "WARNING: No annotations found — nothing will be exported."
}

// --------------------------------------------------
// Build list of all candidate tile positions up-front
// --------------------------------------------------
def allPositions = []
for (int y = 0; y < height; y += tileSize) {
    for (int x = 0; x < width; x += tileSize) {
        allPositions << [x: x, y: y]
    }
}

print "Total tile positions to check: ${allPositions.size()}"

// --------------------------------------------------
// Atomic counters (thread-safe)
// --------------------------------------------------
def tileCounter   = new AtomicInteger(0)
def checkedCounter = new AtomicInteger(0)

// --------------------------------------------------
// Thread pool
// --------------------------------------------------
def pool = Executors.newFixedThreadPool(numThreads)
def futures = new CopyOnWriteArrayList<>()

allPositions.each { pos ->
    futures << pool.submit({
        int x = pos.x
        int y = pos.y
        checkedCounter.incrementAndGet()

        try {
            // ---- Check that ALL four corners are inside gray matter ----
            def corners = [
                [x,            y           ],
                [x + tileSize, y           ],
                [x,            y + tileSize],
                [x + tileSize, y + tileSize]
            ]

            boolean isFullyGray = corners.every { corner ->
                grayAnnotations.any { ann ->
                    ann.getROI().contains(corner[0] as double, corner[1] as double)
                }
            }

            if (!isFullyGray)
                return

            // ---- Only read image if fully inside gray matter ----
            def region = RegionRequest.createInstance(
                server.getPath(),
                downsample,
                x, y,
                tileSize, tileSize
            )

            def img = server.readRegion(region)
            if (img == null)
                return

            // tileID is now just x/y based — no shared sequential counter needed for naming
            def outPath = outDir + File.separator +
                String.format("tile_x%d_y%d_gray_matter.jpg", x, y)

            ImageIO.write(img, "JPEG", new File(outPath))

            int exported = tileCounter.incrementAndGet()
            if (exported % 100 == 0) {
                print "Exported ${exported} gray tiles (checked ${checkedCounter.get()})"
            }

        } catch (Exception e) {
            print "Skipped tile at x=${x}, y=${y}: ${e.getMessage()}"
        }
    } as Runnable)
}

// Wait for all tasks to complete
pool.shutdown()
pool.awaitTermination(24, java.util.concurrent.TimeUnit.HOURS)

print "DONE — Exported ${tileCounter.get()} GRAY MATTER tiles for scan ${imageName}"
