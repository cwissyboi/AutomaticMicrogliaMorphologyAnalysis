import qupath.lib.regions.RegionRequest
import qupath.lib.objects.PathAnnotationObject
import qupath.lib.roi.interfaces.ROI
import ij.IJ
import ij.ImagePlus

import java.awt.image.BufferedImage
import java.awt.Graphics2D
import java.awt.Color
import javax.imageio.ImageIO


// ================= USER SETTINGS =================
def outDir = "C:/Users/chris/Desktop/University/Thesis/AnnotationsData/Segmentations"

def baseDownsample = 1.0
def maxPatchSidePx = 1024
def hardSkipSidePx = 8000
def padPx = 0

def wholeClassName = "MG whole"
def bodyClassName  = "MG cell body"
// ================================================


// Avoid ImageIO disk cache stalls on Windows
ImageIO.setUseCache(false)

// helper: safe folder token
def safeToken = { String s ->
    if (s == null) return "Unclassified"
    return s.trim()
            .replaceAll("\\s+", "_")
            .replaceAll("[^a-zA-Z0-9_-]", "_")
}

// Base folders
def imagesRoot = buildFilePath(outDir, "images")
def masksRoot  = buildFilePath(outDir, "masks")
mkdirs(imagesRoot)
mkdirs(masksRoot)

def imageData = getCurrentImageData()
def server = imageData.getServer()
def hierarchy = imageData.getHierarchy()
def imageName = getProjectEntry().getImageName()

// Per-image folders
def imageImgDir  = buildFilePath(imagesRoot, imageName)
def imageMaskDir = buildFilePath(masksRoot,  imageName)
mkdirs(imageImgDir)
mkdirs(imageMaskDir)

// Per-class folders
def imgWholeDir   = buildFilePath(imageImgDir,  safeToken(wholeClassName))
def maskWholeDir  = buildFilePath(imageMaskDir, safeToken(wholeClassName))
def maskBodyDir   = buildFilePath(imageMaskDir, safeToken(bodyClassName))
mkdirs(imgWholeDir)
mkdirs(maskWholeDir)
mkdirs(maskBodyDir)

// Full-res dimensions
int fullW = server.getWidth()
int fullH = server.getHeight()

def annotations = hierarchy.getAnnotationObjects()

def wholeList = annotations.findAll {
    it.getPathClass()?.toString() == wholeClassName
}

def bodyList = annotations.findAll {
    it.getPathClass()?.toString() == bodyClassName
}

println "▶ Found ${wholeList.size()} ${wholeClassName}"
println "▶ Found ${bodyList.size()} ${bodyClassName}"
println "▶ Image size: ${fullW} x ${fullH} (level 0)"


// Loop over WHOLE cells
wholeList.eachWithIndex { PathAnnotationObject whole, int idx ->

    try {
        ROI wholeROI = whole.getROI()

        int x = (int)Math.floor(wholeROI.getBoundsX()) - padPx
        int y = (int)Math.floor(wholeROI.getBoundsY()) - padPx
        int w = (int)Math.ceil(wholeROI.getBoundsWidth()) + 2 * padPx
        int h = (int)Math.ceil(wholeROI.getBoundsHeight()) + 2 * padPx

        if (x < 0) { w += x; x = 0 }
        if (y < 0) { h += y; y = 0 }
        if (x >= fullW || y >= fullH) return
        if (x + w > fullW) w = fullW - x
        if (y + h > fullH) h = fullH - y
        if (w <= 1 || h <= 1) return

        double ds = baseDownsample
        double maxSideFull = Math.max(w, h)
        if (maxSideFull / ds > maxPatchSidePx) {
            ds = Math.ceil(maxSideFull / maxPatchSidePx)
        }

        int outW = (int)Math.round(w / ds)
        int outH = (int)Math.round(h / ds)
        if (outW > hardSkipSidePx || outH > hardSkipSidePx) return

        // New filename (no ann-id mapping logic)
        def baseStem = "ann-${idx}__x-${x}_y-${y}_w-${w}_h-${h}__ds-${ds as int}"
        def fileName = baseStem + ".png"

        def request = RegionRequest.createInstance(server.getPath(), ds, x, y, w, h)

        // ---------- IMAGE ----------
        BufferedImage img = server.readRegion(request)
        ImageIO.write(img, "PNG", new File(imgWholeDir, fileName))

        // ---------- WHOLE MASK ----------
        BufferedImage wholeMask = new BufferedImage(img.getWidth(), img.getHeight(), BufferedImage.TYPE_BYTE_GRAY)
        Graphics2D gWhole = wholeMask.createGraphics()
        gWhole.setColor(Color.BLACK)
        gWhole.fillRect(0, 0, wholeMask.getWidth(), wholeMask.getHeight())
        gWhole.setColor(Color.WHITE)
        gWhole.translate(-x, -y)
        if (ds != 1.0) gWhole.scale(1.0 / ds, 1.0 / ds)
        gWhole.fill(wholeROI.getShape())
        gWhole.dispose()
        IJ.save(new ImagePlus("mask", wholeMask), new File(maskWholeDir, fileName).getAbsolutePath())

        // ---------- BODY MASK (union, same filename) ----------
        def bodiesInside = bodyList.findAll { body ->
            def bodyROI = body.getROI()
            wholeROI.getShape().contains(bodyROI.getCentroidX(), bodyROI.getCentroidY())
        }

        BufferedImage bodyMask = new BufferedImage(img.getWidth(), img.getHeight(), BufferedImage.TYPE_BYTE_GRAY)
        Graphics2D gBody = bodyMask.createGraphics()
        gBody.setColor(Color.BLACK)
        gBody.fillRect(0, 0, bodyMask.getWidth(), bodyMask.getHeight())
        gBody.setColor(Color.WHITE)
        gBody.translate(-x, -y)
        if (ds != 1.0) gBody.scale(1.0 / ds, 1.0 / ds)

        bodiesInside.each { body ->
            gBody.fill(body.getROI().getShape())
        }
        gBody.dispose()

        IJ.save(new ImagePlus("mask", bodyMask), new File(maskBodyDir, fileName).getAbsolutePath())

        img.flush()
        wholeMask.flush()
        bodyMask.flush()

        if ((idx + 1) % 25 == 0) System.gc()

        println "Exported ${baseStem} (bodies inside: ${bodiesInside.size()})"

    } catch (Exception e) {
        println "ERROR on ann-${idx}: ${e.getMessage()}"
    }
}

println "✅ Done"