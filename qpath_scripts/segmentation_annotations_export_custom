import qupath.lib.regions.RegionRequest
import qupath.lib.objects.PathAnnotationObject
import qupath.lib.roi.interfaces.ROI
import ij.IJ
import ij.ImagePlus

import java.awt.image.BufferedImage
import java.awt.Graphics2D
import java.awt.Color
import javax.imageio.ImageIO


// ================= USER SETTINGS =================
def outDir = "C:/Users/chris/Desktop/University/Thesis/AnnotationsData/Segmentations"

// Base downsample (minimum). 1.0 = full res
def baseDownsample = 1.0

// Max width/height (in pixels) of exported patches AFTER downsampling
def maxPatchSidePx = 1024

// If an annotation is still bigger than this after auto-downsampling, skip it
def hardSkipSidePx = 8000

// Add context padding around each annotation (in FULL-RES pixels)
def padPx = 0
// ================================================


// Avoid ImageIO disk cache stalls on Windows
ImageIO.setUseCache(false)

// Base folders
def imagesRoot = buildFilePath(outDir, "images")
def masksRoot  = buildFilePath(outDir, "masks")
mkdirs(imagesRoot)
mkdirs(masksRoot)

def imageData = getCurrentImageData()
def server = imageData.getServer()
def hierarchy = imageData.getHierarchy()
def imageName = getProjectEntry().getImageName()

// Per-image folders
def imageImgDir  = buildFilePath(imagesRoot, imageName)
def imageMaskDir = buildFilePath(masksRoot,  imageName)
mkdirs(imageImgDir)
mkdirs(imageMaskDir)

def annotations = hierarchy.getAnnotationObjects()
def total = annotations.size()

// Full-res dimensions
int fullW = server.getWidth()
int fullH = server.getHeight()

println "▶ Found ${total} annotations"
println "▶ Image size: ${fullW} x ${fullH} (level 0)"
println "▶ Output image folder: ${imageImgDir}"


annotations.eachWithIndex { PathAnnotationObject ann, int idx ->

    try {
        ROI roi = ann.getROI()

        double xD = roi.getBoundsX()
        double yD = roi.getBoundsY()
        double wD = roi.getBoundsWidth()
        double hD = roi.getBoundsHeight()

        if (wD <= 1 || hD <= 1) {
            println "[${idx + 1} / ${total}] Skipping tiny annotation ${idx}"
            return
        }

        // ---- FULL-RES crop bounds ----
        int x = (int)Math.floor(xD) - padPx
        int y = (int)Math.floor(yD) - padPx
        int w = (int)Math.ceil(wD) + 2 * padPx
        int h = (int)Math.ceil(hD) + 2 * padPx

        // ---- Clamp to image ----
        if (x < 0) { w += x; x = 0 }
        if (y < 0) { h += y; y = 0 }
        if (x >= fullW || y >= fullH) return
        if (x + w > fullW) w = fullW - x
        if (y + h > fullH) h = fullH - y
        if (w <= 1 || h <= 1) return

        // ---- Auto-downsample ----
        double ds = baseDownsample
        double maxSideFull = Math.max(w, h)
        if (maxSideFull / ds > maxPatchSidePx) {
            ds = Math.ceil(maxSideFull / maxPatchSidePx)
        }

        int outW = (int)Math.round(w / ds)
        int outH = (int)Math.round(h / ds)

        if (outW > hardSkipSidePx || outH > hardSkipSidePx) {
            println "[${idx + 1} / ${total}] Skipping huge annotation ${idx}"
            return
        }

        // ---- Class name ----
        def pathClass = ann.getPathClass()
        def className = pathClass == null ? "Unclassified" : pathClass.toString()
        className = className.replaceAll("[^a-zA-Z0-9_-]", "_")

        // Per-class folders (created on demand)
        def classImgDir  = buildFilePath(imageImgDir,  className)
        def classMaskDir = buildFilePath(imageMaskDir, className)
        mkdirs(classImgDir)
        mkdirs(classMaskDir)

        // ---- Filename (still includes bbox for traceability) ----
        def baseName =
            "ann-${idx}" +
            "__x-${x}_y-${y}_w-${w}_h-${h}" +
            "__ds-${ds as int}"

        def request = RegionRequest.createInstance(
            server.getPath(),
            ds,
            x,
            y,
            w,
            h
        )

        // ---------- IMAGE ----------
        BufferedImage img = server.readRegion(request)
        ImageIO.write(img, "PNG", new File(classImgDir, baseName + ".png"))

        // ---------- MASK ----------
        BufferedImage mask = new BufferedImage(
            img.getWidth(),
            img.getHeight(),
            BufferedImage.TYPE_BYTE_GRAY
        )

        Graphics2D g2d = mask.createGraphics()
        g2d.setColor(Color.BLACK)
        g2d.fillRect(0, 0, mask.getWidth(), mask.getHeight())

        g2d.setColor(Color.WHITE)
        def shape = roi.getShape()
        g2d.translate(-x, -y)
        if (ds != 1.0) g2d.scale(1.0 / ds, 1.0 / ds)
        g2d.fill(shape)
        g2d.dispose()

        ImagePlus maskImp = new ImagePlus("mask", mask)
        IJ.save(maskImp, new File(classMaskDir, baseName + ".png").getAbsolutePath())
        maskImp.close()

        img.flush()
        mask.flush()

        if ((idx + 1) % 25 == 0) System.gc()

        println "[${idx + 1} / ${total}] Exported ${imageName}/${className}/${baseName}"

    } catch (Exception e) {
        println "[${idx + 1} / ${total}] ERROR on annotation ${idx}: ${e.getMessage()}"
    }
}

println "✅ Done exporting ${total} annotations"
