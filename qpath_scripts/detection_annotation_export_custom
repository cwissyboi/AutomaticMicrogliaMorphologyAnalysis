import qupath.lib.regions.RegionRequest
import qupath.lib.objects.PathAnnotationObject
import qupath.lib.roi.interfaces.ROI

import javax.imageio.ImageIO
import java.awt.image.BufferedImage
import java.io.File
import java.lang.Math
import java.util.Random

ImageIO.setUseCache(false)

// ================= USER SETTINGS =================
def outDir = "C:/Users/chris/Desktop/YOLO_dataset"
def splitName = "train"
def patchSize = 512
def downsample = 1.0

// ---- SINGLE CLASS CONFIG ----
def TARGET_CLASS_NAME = "MG whole"   // must match QuPath class name exactly
def TARGET_CLASS_ID   = 0            // YOLO class id

// Randomness (set seed for reproducibility)
def RNG_SEED = 1337
// ================================================

def rng = new Random(RNG_SEED)


// --------------------------------------------------
// Setup output folders
// --------------------------------------------------
def imagesDir = buildFilePath(outDir, "images", splitName)
def labelsDir = buildFilePath(outDir, "labels", splitName)
mkdirs(imagesDir)
mkdirs(labelsDir)


// --------------------------------------------------
// Access image + annotations
// --------------------------------------------------
def imageData = getCurrentImageData()
def server = imageData.getServer()
def hierarchy = imageData.getHierarchy()
def imageName = getProjectEntry().getImageName()

int fullW = server.getWidth()
int fullH = server.getHeight()

// ---- FILTER ANNOTATIONS ONCE ----
def annotations = hierarchy.getAnnotationObjects().findAll { ann ->
    def pc = ann.getPathClass()
    pc != null && pc.getName() == TARGET_CLASS_NAME
}

println "▶ Found ${annotations.size()} annotations of class '${TARGET_CLASS_NAME}'"

// Output image size in pixels after downsample
int outPatchSize = (int)Math.round(patchSize / downsample)


// --------------------------------------------------
// Helper: random patch that fully contains ROI
// --------------------------------------------------
def getRandomPatchXYContainingROI = { ROI roi ->

    double ax1 = roi.getBoundsX()
    double ay1 = roi.getBoundsY()
    double ax2 = ax1 + roi.getBoundsWidth()
    double ay2 = ay1 + roi.getBoundsHeight()

    // Valid patch top-left ranges
    int minX = (int)Math.floor(ax2 - patchSize)
    int maxX = (int)Math.ceil(ax1)
    int minY = (int)Math.floor(ay2 - patchSize)
    int maxY = (int)Math.ceil(ay1)

    // Clamp to image
    minX = Math.max(0, minX)
    minY = Math.max(0, minY)
    maxX = Math.min(fullW - patchSize, maxX)
    maxY = Math.min(fullH - patchSize, maxY)

    // Fallback: center if annotation is larger than patch
    if (minX > maxX || minY > maxY) {
        int cx = (int)Math.round(ax1 + roi.getBoundsWidth() / 2.0 - patchSize / 2.0)
        int cy = (int)Math.round(ay1 + roi.getBoundsHeight() / 2.0 - patchSize / 2.0)
        cx = Math.max(0, Math.min(fullW - patchSize, cx))
        cy = Math.max(0, Math.min(fullH - patchSize, cy))
        return [cx, cy]
    }

    int px = minX + rng.nextInt(maxX - minX + 1)
    int py = minY + rng.nextInt(maxY - minY + 1)

    return [px, py]
}


// --------------------------------------------------
// Helper: bounding-box intersection test
// --------------------------------------------------
def intersectsPatch = { ROI roi, int px, int py ->
    double ax1 = roi.getBoundsX()
    double ay1 = roi.getBoundsY()
    double ax2 = ax1 + roi.getBoundsWidth()
    double ay2 = ay1 + roi.getBoundsHeight()

    return (ax1 < px + patchSize && ax2 > px &&
            ay1 < py + patchSize && ay2 > py)
}


// --------------------------------------------------
// Step 1: build patch locations (randomised)
// --------------------------------------------------
def patchKeys = new LinkedHashSet<String>()

for (PathAnnotationObject ann : annotations) {
    ROI roi = ann.getROI()
    if (roi == null) continue
    def (px, py) = getRandomPatchXYContainingROI(roi)
    patchKeys.add("${px}_${py}")
}

println "▶ Unique patches to export: ${patchKeys.size()}"


// --------------------------------------------------
// Step 2: export patches + YOLO labels
// --------------------------------------------------
int patchIdx = 0

for (String key : patchKeys) {

    def parts = key.split("_")
    int px = parts[0].toInteger()
    int py = parts[1].toInteger()

    def request = RegionRequest.createInstance(
        server.getPath(),
        downsample,
        px, py,
        patchSize, patchSize
    )

    BufferedImage img = server.readBufferedImage(request)
    if (img == null) continue

    def baseName = String.format(
        "%s_x%d_y%d_ps%d",
        imageName, px, py, patchSize
    )

    ImageIO.write(
        img, "PNG",
        new File(buildFilePath(imagesDir, baseName + ".png"))
    )

    def labelLines = []

    for (PathAnnotationObject ann : annotations) {

        ROI roi = ann.getROI()
        if (roi == null) continue
        if (!intersectsPatch(roi, px, py)) continue

        double ax1 = roi.getBoundsX()
        double ay1 = roi.getBoundsY()
        double ax2 = ax1 + roi.getBoundsWidth()
        double ay2 = ay1 + roi.getBoundsHeight()

        double ix1 = Math.max(ax1, px)
        double iy1 = Math.max(ay1, py)
        double ix2 = Math.min(ax2, px + patchSize)
        double iy2 = Math.min(ay2, py + patchSize)

        double iw = ix2 - ix1
        double ih = iy2 - iy1
        if (iw <= 1 || ih <= 1) continue

        double rx1 = (ix1 - px) / downsample
        double ry1 = (iy1 - py) / downsample
        double bw = iw / downsample
        double bh = ih / downsample

        double xc = (rx1 + bw / 2.0) / outPatchSize
        double yc = (ry1 + bh / 2.0) / outPatchSize

        labelLines.add(
            String.format(
                "%d %.6f %.6f %.6f %.6f",
                TARGET_CLASS_ID,
                xc, yc,
                bw / outPatchSize,
                bh / outPatchSize
            )
        )
    }

    new File(buildFilePath(labelsDir, baseName + ".txt")).text =
        labelLines.join("\n")

    patchIdx++
    if (patchIdx % 50 == 0)
        println "Exported ${patchIdx} patches"
}

println "✅ Done — exported ${patchIdx} YOLO patches with RANDOMIZED object positions"
