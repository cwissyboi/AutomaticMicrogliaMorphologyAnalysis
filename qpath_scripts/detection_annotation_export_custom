import qupath.lib.regions.RegionRequest
import qupath.lib.objects.PathAnnotationObject
import qupath.lib.roi.interfaces.ROI

import javax.imageio.ImageIO
import java.awt.image.BufferedImage
import java.io.File
import java.lang.Math

ImageIO.setUseCache(false)

// ================= USER SETTINGS =================
def outDir = "C:/Users/chris/Desktop/YOLO_dataset"
def splitName = "train"          // "train" or "val"
def patchSize = 512              // patch size in *full-res pixels*
def downsample = 1.0             // 1.0 = full resolution
def defaultClassId = 0           // single-class default

// Optional multi-class mapping by QuPath class name
// Example: def classMap = ["Cell":0, "Debris":1]
def classMap = null              // set to null for single-class
// ================================================

// --------------------------------------------------
// Setup output folders
// --------------------------------------------------
def imagesDir = buildFilePath(outDir, "images", splitName)
def labelsDir = buildFilePath(outDir, "labels", splitName)
mkdirs(imagesDir)
mkdirs(labelsDir)

// --------------------------------------------------
// Access image + annotations
// --------------------------------------------------
def imageData = getCurrentImageData()
def server = imageData.getServer()
def hierarchy = imageData.getHierarchy()
def imageName = getProjectEntry().getImageName()

int fullW = server.getWidth()
int fullH = server.getHeight()

def annotations = hierarchy.getAnnotationObjects()
println "▶ Found ${annotations.size()} annotations"

// Output image size in pixels after downsample
int outPatchSize = (int)Math.round(patchSize / downsample)
println "▶ Export patch: ${patchSize} (full-res) → ${outPatchSize} (output px)"

// --------------------------------------------------
// Helper: compute centered patch (x,y) in full-res
// --------------------------------------------------
def getPatchXYCentered = { ROI roi ->
    double cx = roi.getBoundsX() + roi.getBoundsWidth()  / 2.0
    double cy = roi.getBoundsY() + roi.getBoundsHeight() / 2.0

    int x = (int)Math.round(cx - patchSize / 2.0)
    int y = (int)Math.round(cy - patchSize / 2.0)

    // Clamp to image bounds
    if (x < 0) x = 0
    if (y < 0) y = 0
    if (x + patchSize > fullW) x = fullW - patchSize
    if (y + patchSize > fullH) y = fullH - patchSize

    return [x, y]
}

// --------------------------------------------------
// Helper: bounding-box intersection test (full-res)
// --------------------------------------------------
def intersectsPatch = { ROI roi, int px, int py ->
    double ax1 = roi.getBoundsX()
    double ay1 = roi.getBoundsY()
    double ax2 = ax1 + roi.getBoundsWidth()
    double ay2 = ay1 + roi.getBoundsHeight()

    double px1 = px
    double py1 = py
    double px2 = px + patchSize
    double py2 = py + patchSize

    return (ax1 < px2 && ax2 > px1 && ay1 < py2 && ay2 > py1)
}

// --------------------------------------------------
// Step 1: build unique patch locations
// --------------------------------------------------
def patchKeys = new LinkedHashSet<String>()

for (PathAnnotationObject ann : annotations) {
    ROI roi = ann.getROI()
    if (roi == null) continue
    def (px, py) = getPatchXYCentered(roi)
    patchKeys.add("${px}_${py}")
}

println "▶ Unique patches to export: ${patchKeys.size()}"

// --------------------------------------------------
// Step 2: export patches + YOLO labels
// --------------------------------------------------
int patchIdx = 0

for (String key : patchKeys) {

    def parts = key.split("_")
    int px = parts[0].toInteger()
    int py = parts[1].toInteger()

    // ---- Read image patch ----
    def request = RegionRequest.createInstance(
        server.getPath(),
        downsample,
        px, py,
        patchSize, patchSize
    )

    BufferedImage img = server.readBufferedImage(request)
    if (img == null) continue

    def baseName = String.format(
        "%s_x%d_y%d_ps%d",
        imageName, px, py, patchSize
    )

    ImageIO.write(
        img, "PNG",
        new File(buildFilePath(imagesDir, baseName + ".png"))
    )

    // ---- Build YOLO label ----
    def labelLines = []

    for (PathAnnotationObject ann : annotations) {

        ROI roi = ann.getROI()
        if (roi == null) continue
        if (!intersectsPatch(roi, px, py)) continue

        // Resolve class ID
        int classId = defaultClassId
        if (classMap != null) {
            def pc = ann.getPathClass()
            def clsName = (pc == null) ? null : pc.getName()
            if (clsName == null || !classMap.containsKey(clsName)) continue
            classId = classMap[clsName]
        }

        // Annotation bounds (full-res)
        double ax1 = roi.getBoundsX()
        double ay1 = roi.getBoundsY()
        double ax2 = ax1 + roi.getBoundsWidth()
        double ay2 = ay1 + roi.getBoundsHeight()

        // Patch bounds (full-res)
        double px1 = px
        double py1 = py
        double px2 = px + patchSize
        double py2 = py + patchSize

        // Intersection (full-res)
        double ix1 = Math.max(ax1, px1)
        double iy1 = Math.max(ay1, py1)
        double ix2 = Math.min(ax2, px2)
        double iy2 = Math.min(ay2, py2)

        double iw = ix2 - ix1
        double ih = iy2 - iy1
        if (iw <= 1 || ih <= 1) continue

        // Convert to patch-relative OUTPUT pixels
        double rx1 = (ix1 - px1) / downsample
        double ry1 = (iy1 - py1) / downsample
        double rx2 = (ix2 - px1) / downsample
        double ry2 = (iy2 - py1) / downsample

        double bw = rx2 - rx1
        double bh = ry2 - ry1

        // YOLO normalized
        double xc = (rx1 + bw / 2.0) / outPatchSize
        double yc = (ry1 + bh / 2.0) / outPatchSize
        double wn = bw / outPatchSize
        double hn = bh / outPatchSize

        labelLines.add(
            String.format("%d %.6f %.6f %.6f %.6f", classId, xc, yc, wn, hn)
        )
    }

    // ---- Save label (empty file is valid) ----
    new File(buildFilePath(labelsDir, baseName + ".txt")).text =
        labelLines.join("\n")

    patchIdx++
    if (patchIdx % 50 == 0)
        println "Exported ${patchIdx} patches"
}

println "✅ Done — exported ${patchIdx} YOLO patches"
